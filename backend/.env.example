# LLM
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 输出预算：推理模型（如 deepseek-v4-flash）的 reasoning 也计入 max_tokens，需要留足余量
LLM_BRIEF_MAX_TOKENS=3000
LLM_DAILY_MAX_TOKENS=12000
LLM_EXTRACT_MAX_TOKENS=4000
# DeepSeek 推理模型默认把预算花在 reasoning 上；disabled 表示关闭思考模式（推荐），auto 交回模型
LLM_THINKING=disabled

# 数据库与调度
DB_PATH=data/aurora.db
COLLECT_CRON=0 */4 * * *
DAILY_ANALYSIS_HHMM=08:00
SCHEDULER_ENABLED=true

# 采集参数
REQUEST_TIMEOUT_S=20
COLLECT_CONCURRENCY=4
MAX_ARTICLES_PER_SOURCE=20
MAX_CONTENT_CHARS=8000
MAX_ANALYSIS_INPUT_CHARS=6000
TOP_ARTICLES_PER_ANALYSIS=30

# 结构化提取与行情
EXTRACT_ENABLED=true
MARKET_PROVIDER=eastmoney
# 行情标的格式："类别|名称=东方财富secid"，逗号分隔
# 类别取值与前端筛选对齐：index / rate / fx / commodity / volatility / crypto / equity
# 下面这组已逐个实测可用（secid 查法见 README「行情快照」一节），留空则关闭行情快照
MARKET_SYMBOLS=index|美元指数=100.UDI,index|标普500=100.SPX,index|纳斯达克=100.NDX,index|道琼斯=100.DJIA,index|恒生指数=100.HSI,index|日经225=100.N225,index|德国DAX=100.GDAXI,index|上证指数=1.000001,index|沪深300=1.000300,index|创业板指=0.399006,rate|美债10年期收益率=171.US10Y,fx|离岸人民币=133.USDCNH,fx|欧元兑美元=119.EURUSD,commodity|COMEX黄金=101.GC00Y,commodity|COMEX白银=101.SI00Y,commodity|COMEX铜=101.HG00Y,commodity|NYMEX原油=102.CL00Y,commodity|布伦特原油=112.B00Y,commodity|NYMEX天然气=102.NG00Y,equity|苹果=105.AAPL,equity|英伟达=105.NVDA,equity|腾讯控股=116.00700
